# Copy to .env and fill in the three values. Do not commit .env.
# Load into the Maven terminal from the repository root:
#   set -a && source .env && set +a
# Java does not read this file by itself.
#
# API_ENDPOINT looks like https://DATABASE_ID-REGION.apps.astra.datastax.com
# APPLICATION_TOKEN is the portal token (AstraCS prefix). Never commit the real value.

API_ENDPOINT=
APPLICATION_TOKEN=
KEYSPACE_NAME=default_keyspace
